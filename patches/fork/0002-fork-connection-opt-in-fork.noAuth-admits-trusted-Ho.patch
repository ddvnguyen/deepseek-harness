     }
   })
 })
+
+// dsh#02 fork opt-in. Stock behavior (the default) is pinned first, so these
+// double as the mutation check for the flag: with `fork.noAuth` off, a request
+// with no token and no cookie is refused exactly as on upstream alpha.5.
+describe('connection node half: fork.noAuth (dsh#02)', () => {
+  const trusted = { trustedHosts: ['harness.example'] }
+
+  it('stays stock by default: no token or cookie means 401 on the index and the API', async () => {
+    for (const config of [trusted, { ...trusted, fork: { noAuth: false } }]) {
+      const { ctx, connection, dispose } = await mounted(config)
+      expect(ctx.bail('webserver/authorize', { headers: { host: 'harness.example' }, method: 'GET', url: new URL('http://harness.example/'), transport: 'http' }, 'required')).toEqual({ kind: 'deny', status: 401 })
+      expect(connection.admit(fakeRequest({ host: 'harness.example' }))).toEqual({ rejection: 401 })
+      expect(connection.admit(fakeRequest({ host: '127.0.0.1:3080' }))).toEqual({ rejection: 401 })
+      await dispose()
+    }
+  })
+
+  it('serves the index and admits the owner Peer to a trusted Host with no token or cookie', async () => {
+    const { ctx, connection, dispose } = await mounted({ ...trusted, fork: { noAuth: true } })
+    for (const host of ['harness.example', '127.0.0.1:3080', 'localhost']) {
+      expect(ctx.bail('webserver/authorize', { headers: { host }, method: 'GET', url: new URL(`http://${host}/`), transport: 'http' }, 'required')).toEqual({ kind: 'allow', peer: connection.browserPeer })
+      expect(connection.admit(fakeRequest({ host }))).toEqual({ peer: connection.browserPeer })
+    }
+    // A stale or wrong ?token= URL (a restart changes the process token) must
+    // not lock a no-auth deployment out of its own index.
+    expect(ctx.bail('webserver/authorize', { headers: { host: 'harness.example' }, method: 'GET', url: new URL('http://harness.example/?token=stale'), transport: 'http' }, 'required')).toEqual({ kind: 'allow', peer: connection.browserPeer })
+    const staleResponse = fakeResponse()
+    const next = vi.fn(async () => {})
+    await ctx.waterfall('webserver/request', fakeRequest({ host: 'harness.example' }, '/?token=stale'), staleResponse.response, next)
+    expect(next).toHaveBeenCalledOnce()
+    expect(staleResponse.state.status).toBeUndefined()
+    const controller = new AbortController()
+    controller.abort()
+    expect(ctx.bail('webserver/authorize', { headers: { host: 'harness.example' }, url: new URL('http://harness.example/'), transport: 'http', signal: controller.signal }, 'required')).toEqual({ kind: 'deny', status: 401 })
+    expect(connection.admit({ headers: { host: 'harness.example' }, signal: controller.signal })).toEqual({ rejection: 401 })
+    await dispose()
+  })
+
+  it('still rejects an untrusted Host with the flag on: no cookie, no owner Peer, no index', async () => {
+    const { ctx, connection, dispose } = await mounted({ ...trusted, fork: { noAuth: true } })
+    expect(ctx.bail('webserver/authorize', { headers: { host: 'evil.example' }, method: 'GET', url: new URL('http://evil.example/'), transport: 'http' }, 'required')).toEqual({ kind: 'deny', status: 403 })
+    const tokenResponse = fakeResponse()
+    const next = vi.fn(async () => {})
+    await ctx.waterfall('webserver/request', fakeRequest({ host: 'evil.example' }, '/?token=stale'), tokenResponse.response, next)
+    expect(tokenResponse.state.status).toBe(403)
+    expect(next).not.toHaveBeenCalled()
+    expect(connection.admit(fakeRequest({ host: 'evil.example' }))).toEqual({ rejection: 403 })
+    // A HEAD probe of the untrusted index gets the same refusal without a body.
+    expect(ctx.bail('webserver/authorize', { headers: { host: 'evil.example' }, method: 'HEAD', url: new URL('http://evil.example/'), transport: 'http' }, 'required')).toEqual({ kind: 'deny', status: 403 })
+    // The cross-site fence applies as well: a trusted Host with a cross-site
+    // marker or a foreign Origin is not admitted.
+    expect(connection.admit(fakeRequest({ host: 'harness.example', 'sec-fetch-site': 'cross-site' })))
+      .toEqual({ rejection: 403 })
+    expect(connection.admit(fakeRequest({ host: 'harness.example', origin: 'http://evil.example' })))
+      .toEqual({ rejection: 403 })
+    await dispose()
+  })
+})
